# ===================================================
# STANDALONE SUPPLIER SRM PORTAL ENVIRONMENT CONFIG
# ===================================================

# Database: Shared Neon PostgreSQL connection
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require"

# NextAuth: Authentication secret & deployed URL
AUTH_SECRET="your-32-byte-secret-run-openssl-rand-base64-32"
NEXTAUTH_URL="https://supplier-srm.vercel.app"

# Vercel Blob: Shared Private Blob Store ID
BLOB_STORE_ID="store_your_blob_store_id"

# Portal Branding (Optional - Defaults to "SRM Portal")
NEXT_PUBLIC_PORTAL_NAME="SRM Portal"
